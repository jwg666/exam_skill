# 复制为 .env 并填入真实值；.env 已被 gitignore，不会进入版本库
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=your_user
DATABASE_PASSWORD=your_password
DATABASE_NAME=exam_skill

# 服务端 token 签名密钥（openssl rand -hex 32 生成）
AUTH_SECRET=change-me-to-a-random-32-byte-hex

# 短信验证码：aliyun=真实下发（与 rixingyishan 项目同一阿里云通道），其他值=mock（固定 123456，开发用）
SMS_PROVIDER=mock
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_CODE_TTL=300

# 微信小程序登录（server/utils/wechat.ts）：两项都配置时走真实 code2session；
# 任一留空则 mock 模式（配合小程序端 mockOpenid，开发联调用）
WECHAT_APPID=
WECHAT_APPSECRET=
